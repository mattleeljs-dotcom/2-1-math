8. 도시의 하루 전력 사용량 최대/최소 분석
clear; clc; close all;

t = 0:0.01:24;
P = 50 + 18*sin(pi*t/12) + 6*cos(pi*t/4);

[maxP, idxMax] = max(P);
[minP, idxMin] = min(P);
tMax = t(idxMax);
tMin = t(idxMin);

figure;
plot(t, P, 'b-', 'LineWidth', 1.2); hold on;
plot(tMax, maxP, 'ro', 'MarkerSize', 8, 'LineWidth', 1.5);
plot(tMin, minP, 'ks', 'MarkerSize', 8, 'LineWidth', 1.5);
grid on;
xlabel('t (hour)'); ylabel('P(t)');
title('Daily Power Usage');
legend('P(t)', 'Maximum', 'Minimum', 'Location', 'best');

fprintf('8번 최대 전력 사용량: %.6f, 발생 시간: %.2f hour\n', maxP, tMax);
fprintf('8번 최소 전력 사용량: %.6f, 발생 시간: %.2f hour\n', minP, tMin);

9. 센서 측정값 사이의 각도 계산
clear; clc; close all;

X = [1 3 0; 2 5 1; 4 8 3; 7 12 5; 11 17 9];
x1 = X(:,1);
x2 = X(:,2);
x3 = X(:,3);

theta12 = acosd(dot(x1,x2)/(norm(x1)*norm(x2)));
theta13 = acosd(dot(x1,x3)/(norm(x1)*norm(x3)));
theta23 = acosd(dot(x2,x3)/(norm(x2)*norm(x3)));
theta = [theta12, theta13, theta23];

[minTheta, idx] = min(theta);
pairs = [1 2; 1 3; 2 3];
bestPair = pairs(idx, :);

disp('9번 세 각도 theta = [theta12 theta13 theta23]'); disp(theta);
fprintf('9번 가장 작은 각도: %.6f degree\n', minTheta);
fprintf('9번 가장 방향이 비슷한 센서: %d번 센서와 %d번 센서\n', bestPair(1), bestPair(2));

