1. 시간 t에 따른 신호와 국소 최대값 찾기
clear; clc; close all;

t = 0:0.01:30;
f = exp(-0.12*t).*sin(5*t) + 0.3*cos(2*t);
u = exp(-0.12*t) + 0.3;
l = -exp(-0.12*t) - 0.3;

figure;
plot(t, f, 'b-', 'LineWidth', 1.2); hold on;
plot(t, u, 'r--', 'LineWidth', 1.1);
plot(t, l, 'k--', 'LineWidth', 1.1);
grid on;
xlabel('t'); ylabel('value');
title('Signal f(t) and Auxiliary Curves');
legend('f(t)', 'u(t)', 'l(t)', 'Location', 'best');

idx = find(f(2:end-1) > f(1:end-2) & f(2:end-1) > f(3:end)) + 1;
plot(t(idx), f(idx), 'ro', 'MarkerSize', 6, 'LineWidth', 1.2);

localMaxTable = table(t(idx)', f(idx)', 'VariableNames', {'t_value', 'f_value'});
disp('1번 국소 최대값 후보 table');
disp(localMaxTable);

2. 2변수 함수의 3차원 그래프와 최댓값 위치
clear; clc; close all;

x = -5:0.05:5;
y = -5:0.05:5;
[X, Y] = meshgrid(x, y);
Z = sin(X.*Y) ./ (1 + X.^2 + Y.^2);

figure;
mesh(X, Y, Z);
grid on;
xlabel('x'); ylabel('y'); zlabel('z');
title('Mesh Graph of z = sin(xy)/(1+x^2+y^2)');

figure;
contour(X, Y, Z, 25);
grid on;
xlabel('x'); ylabel('y');
title('Contour Graph with 25 Levels');
colorbar;

[maxAbsZ, idx] = max(abs(Z(:)));
[row, col] = ind2sub(size(Z), idx);
xMax = X(row, col);
yMax = Y(row, col);

fprintf('2번 |Z|의 최댓값: %.6f\n', maxAbsZ);
fprintf('2번 |Z|가 최대가 되는 위치: x = %.2f, y = %.2f\n', xMax, yMax);

3. 행렬 A의 고유값과 고유벡터 분석
clear; clc; close all;

A = [7 2 1; 2 6 -2; 1 -2 5];
[V, D] = eig(A);
eigenValues = diag(D);
[lambdaMax, index] = max(eigenValues);
v = V(:, index);
v_unit = v / norm(v);
check = A*v - lambdaMax*v;

disp('3번 고유벡터 행렬 V'); disp(V);
disp('3번 고유값 행렬 D'); disp(D);
disp('3번 고유값 벡터'); disp(eigenValues);
fprintf('3번 가장 큰 고유값 lambdaMax = %.6f, index = %d\n', lambdaMax, index);
disp('3번 가장 큰 고유값에 대응하는 고유벡터 v'); disp(v);
disp('3번 단위벡터 v/norm(v)'); disp(v_unit);
disp('3번 Av - lambdaMax*v'); disp(check);

4. 데이터 행렬 중심화와 고유값 분석
clear; clc; close all;

X = [2 5 1; 4 8 3; 6 11 7; 9 15 10; 13 20 14];
colMean = mean(X);
Xc = X - colMean;
S = Xc' * Xc;
[V, D] = eig(S);
eigenValues = diag(D);
[lambdaMax, index] = max(eigenValues);
vMax = V(:, index);

disp('4번 각 열의 평균'); disp(colMean);
disp('4번 중심화 행렬 Xc'); disp(Xc);
disp('4번 S = Xc'' * Xc'); disp(S);
disp('4번 S의 고유값'); disp(eigenValues);
fprintf('4번 가장 큰 고유값 = %.6f\n', lambdaMax);
disp('4번 가장 큰 고유값에 대응하는 고유벡터'); disp(vMax);

5. 연립방정식 풀이 방법 비교
clear; clc; close all;

A = [5 2 -1; -2 6 3; 1 -1 7];
b = [8; 5; 12];

x1 = inv(A) * b;
x2 = A \ b;
diff = x1 - x2;
detA = det(A);

disp('5번 inv(A)*b로 구한 해 x1'); disp(x1);
disp('5번 A\b로 구한 해 x2'); disp(x2);
disp('5번 두 결과의 차이 x1-x2'); disp(diff);
fprintf('5번 det(A) = %.6f\n', detA);
if detA ~= 0
    disp('det(A)가 0이 아니므로 해가 유일하게 존재한다.');
else
    disp('det(A)가 0이므로 해가 유일하지 않을 수 있다.');
end

6. 감쇠된 2변수 함수의 표면 그래프와 최대/최소 위치
clear; clc; close all;

x = -6:0.05:6;
y = -6:0.05:6;
[X, Y] = meshgrid(x, y);
Z = exp(-0.08*(X.^2 + Y.^2)) .* cos(3*X) .* sin(2*Y);

figure;
surf(X, Y, Z);
shading interp;
grid on;
xlabel('x'); ylabel('y'); zlabel('z');
title('Surface Graph of Z');
colorbar;

figure;
contour(X, Y, Z, 30);
grid on;
xlabel('x'); ylabel('y');
title('Contour Graph with 30 Levels');
colorbar;

[maxZ, idxMax] = max(Z(:));
[minZ, idxMin] = min(Z(:));
[rowMax, colMax] = ind2sub(size(Z), idxMax);
[rowMin, colMin] = ind2sub(size(Z), idxMin);

fprintf('6번 Z의 최대값: %.6f, 위치: x = %.2f, y = %.2f\n', maxZ, X(rowMax,colMax), Y(rowMax,colMax));
fprintf('6번 Z의 최소값: %.6f, 위치: x = %.2f, y = %.2f\n', minZ, X(rowMin,colMin), Y(rowMin,colMin));

7. 서버 사용자 수와 평균 응답시간 그래프 비교
