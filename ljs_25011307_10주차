12. 머신러닝 학습 손실 감소 분석
clear; clc; close all;

epoch = [1, 2, 5, 10, 20, 50, 100, 200];
loss = [3.1, 2.4, 1.7, 1.2, 0.83, 0.36, 0.14, 0.06];

figure;
plot(epoch, loss, 'o-', 'LineWidth', 1.2); grid on;
xlabel('epoch'); ylabel('loss');
title('Training Loss');

figure;
semilogy(epoch, loss, 'o-', 'LineWidth', 1.2); grid on;
xlabel('epoch'); ylabel('loss');
title('Training Loss in Log Scale');

r = loss(2:end) ./ loss(1:end-1);
meanR = mean(r);

disp('12번 비율 벡터 r'); disp(r);
fprintf('12번 평균 비율: %.6f\n', meanR);
if meanR < 1
    disp('평균 비율이 1보다 작으므로 loss가 전반적으로 감소한다고 판단할 수 있다.');
else
    disp('평균 비율이 1보다 작지 않으므로 loss가 전반적으로 감소한다고 판단하기 어렵다.');
end
