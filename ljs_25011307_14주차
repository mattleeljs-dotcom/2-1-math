%%7번
clear; clc;

rng(7)

t = linspace(0,30,300);

trueSignal = ...
    2*sin(0.4*t) + ...
    0.7*cos(1.5*t);

obsSignal = trueSignal + ...
    0.25*randn(size(t));

idx = randperm(length(t),45);

obsSignal(idx) = NaN;

valid = ~isnan(obsSignal);

recLinear = interp1( ...
    t(valid), ...
    obsSignal(valid), ...
    t, ...
    'linear');

recSpline = interp1( ...
    t(valid), ...
    obsSignal(valid), ...
    t, ...
    'spline');

rmseLinear = sqrt( ...
    mean((trueSignal-recLinear).^2));

rmseSpline = sqrt( ...
    mean((trueSignal-recSpline).^2));

figure;

plot(t,trueSignal,'k','LineWidth',2)
hold on

plot(t,obsSignal,'ro')

plot(t,recLinear,'b')

plot(t,recSpline,'g')

legend( ...
    'True Signal', ...
    'Observed', ...
    'Linear', ...
    'Spline')

title('Signal Reconstruction Comparison')

