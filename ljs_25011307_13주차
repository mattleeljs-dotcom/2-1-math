%% Problem 9
clear; clc;

n = 50000;

stage1 = rand(n,1) < 0.94;

stage2 = false(n,1);

idx1 = find(stage1);

stage2(idx1) = rand(length(idx1),1) < 0.91;

stage3 = false(n,1);

idx2 = find(stage2);

stage3(idx2) = rand(length(idx2),1) < 0.88;

finalPass = stage3;

finalRate = mean(finalPass);

fprintf('Final Pass Rate = %.4f\n',finalRate);

fail1 = sum(~stage1);

fail2 = sum(stage1 & ~stage2);

fail3 = sum(stage2 & ~stage3);

passNum = sum(finalPass);

figure;

bar([fail1 fail2 fail3 passNum]);

xticklabels({'Fail1','Fail2','Fail3','Pass'});

ylabel('Count');
title('Inspection Results');

