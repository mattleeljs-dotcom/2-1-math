%% Problem 1
clear; clc;

rng(13);

p = 0.35 + (0.95-0.35)*rand(1,40);

answers = rand(5000,40) < p;

scores = sum(answers,2);

avgScore = mean(scores);
stdScore = std(scores);

fprintf('Average Score = %.4f\n',avgScore);
fprintf('Std Score = %.4f\n',stdScore);

histogram(scores);
xlabel('Score');
ylabel('Frequency');
title('Score Distribution');

ratioAboveMean = mean(scores >= avgScore);

fprintf('Ratio >= Mean = %.4f\n',ratioAboveMean);

