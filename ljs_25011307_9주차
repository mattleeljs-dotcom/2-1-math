%%
% *Saddle Surface 설명:*
% z = x^2 - y^2 는 안장면(saddle surface)이다.
% x 방향으로는 위로 볼록(아래로 오목)한 포물선 형태이고,
% y 방향으로는 아래로 볼록(위로 오목)한 포물선 형태를 가진다.
% 원점(0,0,0)이 안장점(saddle point)이 되며,
% 그래프 모양이 말 안장을 닮아 saddle surface라 부른다.

%% 문제 8
clear; clc;

[X, Y] = meshgrid(-2*pi : 0.1 : 2*pi, -2*pi : 0.1 : 2*pi);
Z = sin(X) .* cos(Y);

figure;
subplot(1,2,1);
mesh(X, Y, Z);
title('mesh: z = sin(x)cos(y)');
xlabel('x');
ylabel('y');
zlabel('z');
grid on;

subplot(1,2,2);
contour(X, Y, Z, 20);
title('contour: z = sin(x)cos(y)');
xlabel('x');
ylabel('y');
colorbar;
grid on;

%%
% *Contour 그래프의 의미:*
% contour 그래프는 3D 함수를 2D 평면에서 등고선으로 표현한 것이다.
% 같은 등고선 위의 점들은 z 값이 동일하며,
% 등고선이 밀집된 곳은 기울기(변화율)가 크고,
% 등고선 간격이 넓은 곳은 변화율이 작음을 나타낸다.
% 또한 등고선의 패턴을 통해 함수의 극값(최대/최소)의 위치를 파악할 수 있다.

%% 문제 9
clear; clc;

t = 0 : 0.01 : 25;
y = exp(-0.15*t) .* cos(4*t);
env_up   =  exp(-0.15*t);
env_down = -exp(-0.15*t);

% (a) 일반 plot
figure;
subplot(1,3,1);
plot(t, y);
title('(a) y(t) = e^{-0.15t}cos(4t)');
xlabel('t');
ylabel('y');
grid on;

% (b) envelope 추가
subplot(1,3,2);
plot(t, y, 'b'); hold on;
plot(t, env_up,   'r--', 'LineWidth', 1.5);
plot(t, env_down, 'r--', 'LineWidth', 1.5);
hold off;
title('(b) 신호 + Envelope');
xlabel('t');
ylabel('y');
legend('y(t)', 'upper envelope', 'lower envelope');
grid on;

% (c) |y(t)| semilogy
subplot(1,3,3);
semilogy(t, abs(y));
title('(c) semilogy: |y(t)|');
xlabel('t');
ylabel('|y(t)| (log scale)');
grid on;

%%
% *(c) 설명:*
% |y(t)|를 semilogy로 나타내면 진폭이 지수적으로 감쇠하는 부분이
% 거의 직선 형태로 나타난다.
% 이는 감쇠 계수(0.15)가 log 스케일에서 기울기로 직접 드러나기 때문이며,
% 코사인 진동에 의한 값 변동은 로그 스케일에서 위아래 떨림으로 표시된다.

%% 문제 10
clear; clc;

[X, Y] = meshgrid(-6 : 0.1 : 6, -6 : 0.1 : 6);
Z = cos(X) .* sin(Y) .* exp(-0.05*(X.^2 + Y.^2));

% (a) mesh
figure;
subplot(1,2,1);
mesh(X, Y, Z);
title('(a) mesh: z = cos(x)sin(y)e^{-0.05(x^2+y^2)}');
xlabel('x'); ylabel('y'); zlabel('z');
grid on;

% (b) contour
subplot(1,2,2);
contour(X, Y, Z, 20);
title('(b) contour');
xlabel('x'); ylabel('y');
