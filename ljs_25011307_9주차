grid on;

% (c) 최대값과 위치 추정
[max_val, idx] = max(Z(:));
[row, col] = ind2sub(size(Z), idx);
x_max = X(row, col);
y_max = Y(row, col);

fprintf('Z의 최대값: %.4f\n', max_val);
