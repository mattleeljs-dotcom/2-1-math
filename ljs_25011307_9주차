%%
% *A^2와 A.^2의 차이:*
% A^2 는 행렬 곱 A*A로, 선형대수적 행렬 거듭제곱이다.
% A.^2 는 각 원소를 개별적으로 제곱한 것으로, 결과 행렬의 각 원소는 원래 원소의 제곱이다.
% 따라서 두 결과는 일반적으로 다르다.

% (b) det(A)
d = det(A);
fprintf('det(A) = %.4f\n', d);
if abs(d) > 1e-10
    disp('det(A) ≠ 0 이므로 역행렬이 존재한다.');
else
    disp('det(A) = 0 이므로 역행렬이 존재하지 않는다.');
end

% (c) inv(A)*b vs A\b
x_inv = inv(A) * b;
x_bs  = A \ b;

disp('inv(A)*b =');
disp(x_inv);
disp('A\b =');
disp(x_bs);

%%
% *비교:* 두 방법 모두 동일한 해를 반환한다.
% 다만 A\b 는 수치적으로 더 안정적이고 효율적이다.

% (d) 선형 연립방정식의 해
x = A \ b;
fprintf('Ax = b 의 해:\n');
disp(x);

%% 문제 19
clear; clc;

A = [2 -1; 3 4];
B = [1 0 -2; 3 5 1];
C = [6 -3 4; 15 14 -1];

% (a) AX = C - B
RHS = C - B;

% (b) X = A \ (C-B)
X = A \ RHS;
disp('X =');
disp(X);

% (c) 검증: AX + B == C
verify = A*X + B;
disp('AX + B =');
disp(verify);
disp('C =');
disp(C);
disp('차이 (AX+B - C):');
disp(verify - C);

%%
% *(d) A\(C-B) vs inv(A)*(C-B):*
% inv(A)를 명시적으로 계산하면 수치 오차가 누적될 수 있고 계산 비용도 더 크다.
% A\(C-B)는 LU 분해 등 수치적으로 안정적인 방법을 사용하므로
% 더 정확하고 효율적인 해를 얻을 수 있다.

%% 문제 20
clear; clc;

X = [3  7  2  5;
     5  9  4  6;
     8 12  7 10;
    10 15  9 13;
    14 18 12 16];

% (a) 각 열의 평균
col_mean = mean(X);
disp('각 열의 평균:');
disp(col_mean);

% (b) 중심화 행렬
Xc = X - mean(X);
disp('중심화 행렬 Xc:');
disp(Xc);

% (c) S = Xc' * Xc
S = Xc' * Xc;
disp('S = Xc''*Xc:');
disp(S);

%%
% *(d) S의 원소 의미:*
% 대각원소 S(i,i)는 i번째 열 변수의 (비정규화) 분산에 해당한다.
% 값이 클수록 해당 변수의 데이터가 평균으로부터 크게 퍼져 있음을 의미한다.
%
% 비대각원소 S(i,j) (i≠j)는 i번째와 j번째 열 변수 사이의 (비정규화) 공분산이다.
% 양수이면 두 변수가 같은 방향으로 변하는 경향(양의 상관),
% 음수이면 반대 방향으로 변하는 경향(음의 상관)을 나타낸다.

