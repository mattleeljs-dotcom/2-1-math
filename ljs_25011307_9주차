%%
% *(c) 어떤 그래프가 성장률 비교에 더 적합한가:*
% semilogy(로그 스케일 그래프)가 더 적절하다.
% 일반 plot에서는 T4=2^n이 n이 커지면 매우 빠르게 폭발적으로 증가하여
% 나머지 함수(T1, T2, T3)의 차이가 거의 보이지 않는다.
% 반면 semilogy에서는 각 함수의 성장률 차이가 명확하게 드러나며,
% 지수 함수(T4)는 직선, 다항식(T3)은 완만한 곡선으로 구분되어
% 알고리즘 복잡도 비교에 훨씬 유리하다.

%% 문제 16
clear; clc;

t = 0 : 0.01 : 24;
T = 15 + 10*sin(pi*t / 12);

[T_max, idx_max] = max(T);
[T_min, idx_min] = min(T);
t_max = t(idx_max);
t_min = t(idx_min);

figure;
plot(t, T, 'b-', 'LineWidth', 1.5); hold on;
plot(t_max, T_max, 'rv', 'MarkerSize', 10, 'MarkerFaceColor', 'r');
plot(t_min, T_min, '^', 'Color', [0 0.5 1], 'MarkerSize', 10, 'MarkerFaceColor', [0 0.5 1]);
text(t_max, T_max + 0.8, sprintf('최고 %.1f°C (t=%.1fh)', T_max, t_max), ...
    'HorizontalAlignment','center');
text(t_min, T_min - 1.2, sprintf('최저 %.1f°C (t=%.1fh)', T_min, t_min), ...
    'HorizontalAlignment','center');
hold off;
title('하루 온도 변화: T(t) = 15 + 10sin(\pit/12)');
xlabel('시간 t (h)');
ylabel('온도 T (°C)');
grid on;
legend('온도', '최고 온도', '최저 온도');

