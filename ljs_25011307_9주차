%% 문제 18
clear; clc;

A = [4 -1 2; 1 3 -1; 2 -2 5];
b = [7; 4; 10];

% (a) A^2 vs A.^2
A_pow2    = A^2;
A_elem2   = A.^2;

disp('A^2 (행렬 거듭제곱):');
